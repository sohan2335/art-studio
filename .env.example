# All settings are optional. Defaults work for local development.
PORT=8788
HOST=127.0.0.1
DB_PATH=./data/studio.sqlite
# Studio email defaults to studio@artstudio.in. A new installation generates a password.
# Set these BEFORE the database is first created to replace the demo credentials.
STUDIO_EMAIL=studio@example.com
STUDIO_PASSWORD=replace-with-a-long-password
# Set only when serving over HTTPS behind your own trusted deployment.
COOKIE_SECURE=false
